rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Web data access is server-only through Firebase Admin and AppSession.
    // Admin bypasses these rules: every server query still enforces tenant/role access.
    // Add reviewed tenant-scoped rules before enabling any future mobile/client CRUD.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
