# ServiceFlow technician app — copy this file to .env.local and fill it in.
# Expo builds these values into the app, so they must never contain secrets.
# Restart `npx expo start` after changing them.

# Firebase web app config: the same project and values as NEXT_PUBLIC_FIREBASE_* in apps/web/.env.local
# (Firebase console → Project settings → Your apps). Only Firebase Authentication is used on mobile.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# The ServiceFlow web app that serves /api/mobile (no trailing slash).
#   iOS simulator:     http://localhost:3000
#   Android emulator:  http://10.0.2.2:3000
#   Phone on Wi-Fi:    http://<your computer's Wi-Fi IP address>:3000
#   Production:        https://<your ServiceFlow domain>
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: use the local Firebase Auth emulator (firebase emulators:start).
# Use the same setting as NEXT_PUBLIC_USE_FIREBASE_EMULATOR in apps/web, and run the
# web server with FIREBASE_AUTH_EMULATOR_HOST so it accepts emulator tokens.
#   Android emulator: http://10.0.2.2:9099 · Phone: http://<your computer's Wi-Fi IP address>:9099
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
